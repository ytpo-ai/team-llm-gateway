# ============================================================
# Docker Compose 环境变量
# 复制此文件为 .env 后修改，然后运行 docker compose up -d
# ============================================================

# ---- 端口 ----
MONGO_PORT=27017
REDIS_PORT=6379
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ---- 安全密钥（必填！请修改为随机字符串） ----
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-refresh-to-a-random-string
ENCRYPTION_SECRET=change-me-encryption-to-a-random-string

# ---- 超级管理员引导（可选） ----
# 首次启动时如果数据库无用户，将自动创建该管理员账号
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=admin123

# ---- 渠道健康熔断（可选，使用默认值） ----
# PROVIDER_FAILURE_THRESHOLD=3
# PROVIDER_COOLDOWN_BASE_MS=30000
# PROVIDER_COOLDOWN_MAX_MS=600000
# PROVIDER_RATE_LIMIT_COOLDOWN_MS=60000
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/portal
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_SECRET=change-me-encryption
# 超级管理员（服务商/system 角色）引导，留空则不创建
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Gemini OAuth access_token 缓存：留空用单机内存缓存；多实例部署可配置 Redis（需安装 ioredis）
REDIS_URL=
# 官方模型预置目录远程拉取：留空用内置静态目录
MODEL_PRESETS_URL=
